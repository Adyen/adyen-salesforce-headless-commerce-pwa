@@ -126,9 +126,21 @@ class Extractor {
 
     if (symlink) {
       const link = await getStream(readStream)
+      const resolvedLink = path.resolve(await fs.realpath(path.dirname(dest)), link)
+      const relativeLink = path.relative(this.opts.dir, resolvedLink)
+
+      if (relativeLink === '..' || relativeLink.startsWith(`..${path.sep}`) || path.isAbsolute(relativeLink)) {
+        throw new Error(`Out of bound symlink target "${link}" found while processing file ${entry.fileName}`)
+      }
+
       debug('creating symlink', link, dest)
       await fs.symlink(link, dest)
     } else {
+      const existing = await fs.lstat(dest).catch(() => null)
+      if (existing && existing.isSymbolicLink()) {
+        throw new Error(`Out of bound path "${dest}" found while processing file ${entry.fileName}`)
+      }
+
       await pipeline(readStream, createWriteStream(dest, { mode: procMode }))
     }
   }
