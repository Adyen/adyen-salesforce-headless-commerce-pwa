{
  "name": "adyen-salesforce-pwa",
  "version": "0.0.0",
  "license": "See license in LICENSE",
  "engines": {
    "node": "^16.0.0 || ^18.0.0 || ^20.0.0 || ^22.0.0",
    "npm": "^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.6",
    "@babel/eslint-parser": "^7.15.4",
    "@babel/plugin-proposal-class-properties": "^7.10.4",
    "@babel/plugin-proposal-decorators": "^7.10.4",
    "@babel/plugin-proposal-optional-chaining": "^7.10.3",
    "@babel/plugin-transform-runtime": "^7.10.4",
    "@babel/preset-env": "^7.29.2",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "sgmf-scripts": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "node-notifier": "10.0.1",
      "yargs-parser": "21.1.1",
      "jszip": "3.8.0",
      "merge": "2.1.1",
      "tough-cookie": "4.1.4",
      "serialize-javascript": ">=7.0.5",
      "diff": ">=8.0.3",
      "ws": ">=8.17.1",
      "tar-fs": ">=2.1.4",
      "postcss": ">=8.5.19 <9",
      "compression": ">=1.8.1",
      "cookie": ">=0.7.0",
      "tmp": ">=0.2.4",
      "@babel/core": "^7.29.6",
      "js-yaml": "^4.3.0",
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "uploadCartridge": "sgmf-scripts --uploadCartridge int_adyen_PWA",
    "transpile": "babel ./packages/int_adyen_PWA -d ./cartridges/int_adyen_PWA --copy-files --no-copy-ignored --extensions .js,.test.js,.snap",
    "buildCartridge": "npm run transpile && npm run uploadCartridge",
    "test:cartridge": "jest --config packages/int_adyen_PWA/jest.config.js",
    "test:cartridge:coverage": "jest --config packages/int_adyen_PWA/jest.config.js --coverage",
    "check-branch-name": "chmod 755 ./branching.sh && sh ./branching.sh",
    "prepare": "husky install"
  }
}
